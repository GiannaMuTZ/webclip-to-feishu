{
  "name": "webclip-to-feishu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clip web articles into editable Feishu documents with native equations and tables.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "setup": "node scripts/setup.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "express": "^5.1.0",
    "jsdom": "^26.1.0",
    "katex": "^0.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.317",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
